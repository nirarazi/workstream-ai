{
  "name": "workstream",
  "version": "1.0.0",
  "description": "workstream.ai — The operator's inbox for AI agent fleets",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "classify": "tsx core/classifier/cli.ts",
    "mcp": "tsx core/mcp/cli.ts",
    "relink": "tsx core/graph/relink-cli.ts",
    "eval:sample": "tsx core/eval/sample.ts",
    "eval:label": "tsx core/eval/label.ts",
    "eval:run": "tsx core/eval/run.ts",
    "eval:pairs": "tsx core/eval/pairs.ts",
    "eval:linking": "tsx core/eval/linking.ts",
    "eval:pairs-dump": "tsx core/eval/pairs-dump.ts",
    "eval:agreement": "tsx core/eval/agreement.ts",
    "eval:constraint-labels": "tsx core/eval/constraint-labels.ts",
    "eval:tune": "tsx core/eval/tune.ts",
    "eval:targets": "tsx core/eval/targets.ts",
    "regroup": "tsx core/grouping/regroup-cli.ts",
    "engine": "WORKSTREAM_DEV_UI=true tsx watch core/server.ts",
    "dev:web": "concurrently \"WORKSTREAM_DEV_UI=true tsx watch core/server.ts\" \"vite\"",
    "start:web": "vite build && WORKSTREAM_SERVE_STATIC=true tsx core/server.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/web-api": "^7.15.0",
    "@vitejs/plugin-react": "^6.0.1",
    "better-sqlite3": "^12.8.0",
    "hono": "^4.12.9",
    "lucide-react": "^1.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2"
  }
}

# Copy to .env, or fill these in from the app's Settings screen, which writes .env for you.
# .env is gitignored and holds secrets; Settings writes it readable by your user only.

# Slack user token (xoxp-...). Needs: channels:history, channels:read, groups:history, groups:read,
# im:history, im:read, mpim:history, mpim:read, chat:write, users:read. See docs/slack-setup.md.
WORKSTREAM_SLACK_TOKEN=

# LLM provider: any OpenAI-compatible endpoint (Anthropic, OpenAI, OpenRouter, Ollama, ...)
WORKSTREAM_LLM_API_KEY=
WORKSTREAM_LLM_BASE_URL=https://api.anthropic.com/v1
WORKSTREAM_LLM_MODEL=claude-sonnet-4-6

# Jira (optional). Settings fills all four; by hand, WORKSTREAM_JIRA_TOKEN is base64("email:api_token").
WORKSTREAM_JIRA_BASE_URL=
WORKSTREAM_JIRA_EMAIL=
WORKSTREAM_JIRA_API_TOKEN=
WORKSTREAM_JIRA_TOKEN=

# Decision model (optional, only for classifier.mode: decisions with provider: openai)
# OPENAI_API_KEY=
